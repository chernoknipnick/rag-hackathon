# Скопируйте в .env и меняйте под себя. Ключей и паролей здесь быть не должно.
LLM_MODEL=qwen2.5:3b-instruct      # на GPU можно qwen2.5:7b-instruct; лицензии моделей см. README
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-base
USE_RERANKER=1

# Порог отказа «Нет в документах»: подбирается на своих вопросах (eval/evaluate.py)
MIN_CONFIDENCE=0.3
UNSURE_CONFIDENCE=0.5

# Скорость: меньше кандидатов и контекста = быстрее на CPU
TOP_K_RETRIEVE=12
TOP_K_CONTEXT=3
LLM_MAX_TOKENS=150

# Роутер
ROUTER_NCM_MARGIN=0.03
ROUTER_CENTROIDS=3
ROUTER_FALLBACK_ALL=1
